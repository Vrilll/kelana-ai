DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost/kelana_ai

# Amazon Bedrock (Session 5)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# Auth (Session 8)
# Sign your own secret, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Anyone who knows this value can mint a valid token for any account.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_TTL_HOURS=24

# Origins allowed to call this API from a browser
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
